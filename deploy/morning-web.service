[Unit]
Description=Morning loopback web origin
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/nginx -c /etc/morning/nginx.conf -g 'daemon off;'
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
